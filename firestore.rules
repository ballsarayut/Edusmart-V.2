rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    
    // RBAC Helpers
    // In this app, users are stored with custom IDs. 
    // We assume request.auth.uid matches the document ID in 'users' collection 
    // OR the app logic links them.
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() { return hasRole('ADMIN'); }
    function isTeacher() { return hasRole('TEACHER'); }
    function isAcademic() { return hasRole('ACADEMIC'); }
    function isFinance() { return hasRole('FINANCE'); }
    function isCompany() { return hasRole('COMPANY'); }
    function isParent() { return hasRole('PARENT'); }

    // --- Connectivity Test ---
    match /test/connection {
      allow read: if true;
    }
    match /test/{id} {
      allow read: if true;
    }

    // --- Entity Validations ---

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'studentId', 'name', 'level', 'department', 'room', 'behaviorScore']) &&
             data.id is string && data.id.size() <= 64 &&
             data.studentId is string && data.studentId.size() <= 20 &&
             data.name is string && data.name.size() <= 200 &&
             data.level is string && data.level.size() <= 50 &&
             data.department is string && data.department.size() <= 100 &&
             data.room is string && data.room.size() <= 20 &&
             data.behaviorScore is number;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'studentId', 'date', 'type', 'status', 'timestamp']) &&
             data.id is string &&
             data.studentId is string &&
             data.type in ['MORNING', 'SUBJECT'] &&
             data.status in ['PRESENT', 'LATE', 'ABSENT', 'BUSINESS_LEAVE', 'SICK_LEAVE'] &&
             data.date is string &&
             data.timestamp is string; // App uses ISOStrings
    }

    function isValidBehavior(data) {
      return data.keys().hasAll(['id', 'studentId', 'type', 'score', 'reason', 'date', 'recordedBy']) &&
             data.id is string &&
             data.studentId is string &&
             data.type in ['ADD', 'DEDUCT'] &&
             data.score is number &&
             data.reason is string &&
             data.date is string &&
             data.recordedBy is string;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'username', 'password']) &&
             data.role in ['ADMIN', 'TEACHER', 'PARENT', 'FINANCE', 'ACADEMIC', 'COMPANY'];
    }

    function isValidEnglishScore(data) {
      return data.keys().hasAll(['id', 'studentId', 'score', 'recordedBy', 'date', 'timestamp']) &&
             data.id is string &&
             data.studentId is string &&
             data.score is number && data.score >= 0 && data.score <= 10 &&
             data.recordedBy is string &&
             data.date is string &&
             data.timestamp is string;
    }

    // --- Rules ---

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    match /attendance/{atId} {
      allow read: if true;
      allow create, update, delete: if isValidId(atId);
    }

    match /behavior/{bhId} {
      allow read: if true;
      allow create, update, delete: if isValidId(bhId);
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isValidId(newsId);
    }

    match /subjects/{subId} {
      allow read: if true;
      allow create, update, delete: if isValidId(subId);
    }

    match /payments/{payId} {
      allow read: if true;
      allow create, update, delete: if isValidId(payId);
    }

    match /blocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isValidId(blockId);
    }

    match /tuition_configs/{confId} {
      allow read: if true;
      allow create, update, delete: if isValidId(confId);
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isValidId(jobId);
    }

    match /applications/{appId} {
      allow read: if true;
      allow create, update, delete: if isValidId(appId);
    }

    match /login_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notifId);
    }

    match /english_scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if isValidId(scoreId);
    }

    match /config/{confId} {
      allow read: if true;
      allow write: if isValidId(confId);
    }
  }
}
